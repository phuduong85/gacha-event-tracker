.git
# .github is NOT ignored: the test suite asserts on the refresh workflows, and
# the image build runs that suite as its gate. It reaches the build stage only —
# the runtime stage copies nothing but public/ and serve.ts.
.gitlab-ci.yml
node_modules
public
data
game-icons
*.sqlite
.idea
docs
.claude
README.md
AGENTS.md
CLAUDE.md

# Never in the build context, belt and braces: no Dockerfile instruction
# names these anyway (only explicit files/dirs are COPY'd), but a secret has
# no business being reachable from a build step even for a build that never
# reads it.
.env
.env.*
